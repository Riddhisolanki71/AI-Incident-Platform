# Backend configuration reference.
#
# IMPORTANT: Spring Boot does NOT automatically load a .env file - these values
# must actually be exported in your shell, set in your run configuration, or
# passed via `docker run -e` / `docker compose --env-file`, etc. This file is
# documentation of what's needed, in one place, not a file the app reads
# itself. See application.yml for how each of these maps to a Spring property.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/ai_incident_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT ---
# Required, no default that's safe to use in production. Generate with:
#   openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI provider ---
# "anthropic" for real AI analysis, "mock" (default) to force the rule-based
# mock. If AI_PROVIDER=anthropic but ANTHROPIC_API_KEY is empty, or the real
# API call fails, requests automatically and silently fall back to the mock.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# --- Initial admin account (optional) ---
# If both are set, one ADMIN account is created on first startup if it
# doesn't already exist. Leave blank to skip seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Misc ---
SERVER_PORT=8080
DDL_AUTO=update
SHOW_SQL=false
LOG_LEVEL=INFO
